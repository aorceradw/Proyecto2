# Variables de Entorno - Ejemplo de Configuración
# Copiar este archivo como .env y llenar con los valores reales

# Base de Datos AWS RDS
DB_HOST=tu-endpoint-rds.us-east-1.rds.amazonaws.com
DB_PORT=3306
